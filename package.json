{
  "name": "shitcoin-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Shitcoin — Solana memecoin scanner with layered rug-safety gate. DRY-RUN MVP: no wallet, no trading.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/start.ts",
    "demo": "tsx src/index.ts",
    "demo:snipe": "tsx src/index.ts --mode fast-follow",
    "web": "tsx src/server.ts",
    "strategy2:scout": "tsx src/discovery/strategy2-scout.ts",
    "strategy2:outcome": "tsx src/discovery/strategy2-outcome-tracker.ts",
    "gmgn:kol-watch": "tsx src/discovery/gmgn-kol-watch.ts",
    "strategy2:paper": "tsx src/discovery/strategy2-papertrader.ts",
    "gmgn:launchpads": "tsx src/discovery/gmgn-launchpad-observatory.ts",
    "gmgn:proxy": "tsx src/discovery/gmgn-proxy.ts",
    "wallet": "tsx src/wallet-cli.ts",
    "reset": "rm -f logs/*.jsonl logs/positions.json logs/deployer-reputation.json && echo 'measurement data cleared — fresh start'",
    "typecheck": "tsc --noEmit",
    "exec:selftest": "tsx src/exec-selftest.ts",
    "live-bridge:selftest": "tsx src/live-bridge-selftest.ts",
    "latency:probe": "tsx src/live-latency-probe.ts",
    "rpc:health": "tsx src/rpc-health-probe.ts",
    "execution-semantics:selftest": "tsx src/execution-semantics-selftest.ts",
    "exposure-reservations:selftest": "tsx src/exposure-reservations-selftest.ts",
    "graduation-math:selftest": "tsx src/graduation-math-selftest.ts",
    "rpc-quota:selftest": "tsx src/rpc-quota-selftest.ts",
    "actor-memory:selftest": "tsx src/actor-memory-selftest.ts",
    "arm-ledger:selftest": "tsx src/arm-ledger-selftest.ts",
    "arm-spec:selftest": "tsx src/arm-spec-selftest.ts",
    "arm-admission:selftest": "tsx src/arm-admission-selftest.ts",
    "arm-exit:selftest": "tsx src/arm-exit-selftest.ts",
    "measurement:selftest": "tsx src/measurement-selftest.ts",
    "setup:selftest": "tsx src/setup-selftest.ts",
    "curve-layout:selftest": "tsx src/curve-layout-selftest.ts",
    "curve-overlay:selftest": "tsx src/curve-overlay-selftest.ts",
    "launch-event:selftest": "tsx src/launch-event-selftest.ts",
    "scaleout:selftest": "tsx src/scaleout-selftest.ts",
    "correctness:selftest": "npm run typecheck && npm run measurement:selftest && npm run exec-realism:selftest && npm run mc-band-ab:selftest && npm run exit-lag:selftest && npm run curve-layout:selftest && npm run curve-overlay:selftest && npm run launch-event:selftest && npm run setup:selftest && npm run execution-semantics:selftest && npm run actor-memory:selftest && npm run arm-spec:selftest && npm run arm-admission:selftest && npm run arm-ledger:selftest && npm run arm-exit:selftest && npm run exposure-reservations:selftest && npm run scaleout:selftest && npm run graduation-math:selftest && npm run rpc-quota:selftest && npm run mc-anomaly:selftest && npm run rpc-rotation:selftest && npm run watchdog:selftest",
    "profit:evaluate": "tsx src/profit-evaluator.ts",
    "shadow": "tsx src/shadow.ts",
    "structural:report": "tsx src/calibration.ts",
    "mc-anomaly:selftest": "tsx src/mc-anomaly-selftest.ts",
    "bx:swaps": "tsx src/discovery/bloxroute-swap-recorder.ts",
    "rpc-rotation:selftest": "node src/rpc-rotation-selftest.mjs",
    "ui:check": "npm --prefix web run panel:check && npm --prefix web run poscard:check && npm --prefix web run memo:check",
    "watchdog": "WATCHDOG_RUN=1 node src/watchdog.mjs",
    "watchdog:selftest": "node src/watchdog-selftest.mjs",
    "pantau": "node tools/pantau.mjs",
    "live:truth": "tsx src/live-truth.ts",
    "exec-realism:selftest": "tsx src/exec-realism-selftest.ts",
    "mc-band-ab:selftest": "tsx src/mc-band-ab-selftest.ts",
    "mc-ab:report": "tsx src/mc-band-ab-report.ts",
    "exit-lag:report": "tsx src/exit-lag-report.ts",
    "exit-lag:selftest": "tsx src/exit-lag-selftest.ts",
    "entry-latency:report": "tsx src/entry-latency-report.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@triton-one/yellowstone-grpc": "^1.0.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "gmgn-cli": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
