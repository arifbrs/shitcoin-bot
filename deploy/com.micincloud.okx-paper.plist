<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.micincloud.okx-paper</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/brs/.local/node/bin/node</string>
    <string>--import</string>
    <string>tsx</string>
    <string>src/okx-strict-paper.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/brs/Documents/Application/Micincloud-bot</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/brs/.local/node/bin:/Users/brs/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ExitTimeOut</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/brs/Documents/Application/Micincloud-bot/logs/launchd-okx-paper.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/brs/Documents/Application/Micincloud-bot/logs/launchd-okx-paper.err.log</string>
</dict>
</plist>
