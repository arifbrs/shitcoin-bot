# TEMPLATE AKTIVASI WITHDRAW_MODE=policy (disiapkan round-FINAL, TIDAK AKTIF)
# Operator: (1) isi alamat tujuan tepercaya di bawah, (2) salin 4 baris ini ke .env,
# (3) restart dashboard, (4) verifikasi `npm run withdraw:status` menunjukkan mode=policy.
# Rollback: hapus 4 baris → kembali legacy (perilaku lama). Rollback aman & teruji.
# JANGAN aktif sebelum alamat tepercaya ditetapkan operator — policy tanpa allowlist = fail-closed.
WITHDRAW_MODE=policy
WITHDRAW_ALLOWLIST=<ALAMAT_TEPRCAYA_OPERATOR>
WITHDRAW_MAX_SOL=0.05
WITHDRAW_DAILY_MAX_SOL=0.1
