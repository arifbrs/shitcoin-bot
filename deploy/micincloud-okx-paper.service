[Unit]
Description=Micincloud OKX strict paper trader (unsigned simulation only)
Documentation=https://github.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=micincloud
WorkingDirectory=/opt/micincloud-bot
EnvironmentFile=/opt/micincloud-bot/.env
ExecStart=/usr/bin/npx tsx src/okx-strict-paper.ts

Restart=always
RestartSec=10
StartLimitIntervalSec=600
StartLimitBurst=5
KillSignal=SIGTERM
TimeoutStopSec=30

# This service never needs the local signing key. It can write only its state/ledger under logs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/micincloud-bot/logs
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=micincloud-okx-paper

[Install]
WantedBy=multi-user.target
