# ── MemeCloud dry-run MVP ─────────────────────────────────────────────
# Everything works without keys (public RPC + keyless APIs) but free keys
# raise rate limits a lot. Register per RESEARCH.md §7. NEVER put a wallet
# private key in this file — the MVP has no wallet and must stay that way.

# Helius free key → https://helius.dev (primary RPC). Leave empty to use public RPC.
HELIUS_API_KEY=

# Fallback/custom RPC URL (optional; overrides the public default)
RPC_URL=

# Backup RPC URL (optional) — e.g. FluxRPC from the rugcheck.xyz dashboard
RPC_BACKUP_URL=

# RugCheck report API works keyless (~10 req/min). NOTE: the key shown in the
# rugcheck.xyz dashboard is a FluxRPC key (use it as RPC_BACKUP_URL above), NOT
# a report-API key — api.rugcheck.xyz returns 401 if you send it as X-API-KEY.
RUGCHECK_API_KEY=

# Jupiter free API key (portal.jup.ag) — real swap slippage + sell-sim for swing
# tokens, sent as x-api-key. Works keyless too (lower rate limit).
JUPITER_API_KEY=

# ── GMGN (OpenAPI resmi via gmgn-cli) ───────────────────────────────────────
# Semua proses bicara ke GMGN lewat `npm run gmgn:proxy` (satu-satunya yang menyentuh
# openapi.gmgn.ai). Limit nyata KERAS: burst 14 call/45 detik sudah memicu ban bertingkat
# (server: "repeated requests can extend the ban by 5s up to 5 minutes"). Pace aman terukur
# = ~1 call / 10 detik; kolektor `npm run gmgn:full-watch` menegakkan ini.
GMGN_API_KEY=
# Private key GMGN — menandatangani REQUEST API (kunci auth API, BUKAN kunci wallet on-chain).
# Dipakai oleh S2_EXEC_ROUTE=gmgn (swap) dan/atau GMGN_PORTFOLIO_AUTH=true (baca portfolio).
GMGN_PRIVATE_KEY=
# true = proxy memuat private key untuk READ portfolio (wallet holdings/token balance).
# Swap/order tetap tertutup kecuali S2_EXEC_ROUTE=gmgn. Default aman: false.
GMGN_PORTFOLIO_AUTH=false
GMGN_PROXY_PORT=4319
# Pantauan penuh berprioritas (`npm run gmgn:full-watch`): jarak antar call, perioda siklus,
# dan batas per siklus. GMGN_FULL_WATCH_ONCE=true menjalankan tepat satu siklus lalu keluar.
GMGN_FULL_WATCH_SPACING_MS=10000
GMGN_FULL_WATCH_CYCLE_MS=900000
GMGN_FULL_WATCH_POS_MAX=4
GMGN_FULL_WATCH_CAND_MAX=6
GMGN_FULL_WATCH_WALLET_MAX=6

# ── ROBINHOOD CHAIN (Ethereum L2, chain ID 4663) — PAPER LANE ────────────────
# 10 varian forward test, risk $5/trade, modal awal $100/varian. READ-ONLY: tidak ada wallet,
# tidak ada signing, tidak ada eksekusi. Data gratis tanpa key (GeckoTerminal + DexScreener).
# RPC hanya dipakai panel intel (screening token), bukan oleh lane paper.
ROBINHOOD_RPC_URL=
RH_RISK_USD=5
RH_START_EQUITY_USD=100
RH_MAX_OPEN=8
RH_MAX_NOTIONAL_USD=25
RH_PAPER_CYCLE_MS=180000
# Mark+exit posisi tiap 30 detik (terpisah dari siklus discovery 3 menit). Audit 2026-10-07:
# gap antar-mark 3 menit membuat 13/15 trade rugi melebihi stop nominal — mark rapat memotong itu.
RH_MARK_MS=10000
# Penanda kohort eksperimen. Ganti HANYA bersama reset state (aturan berubah = sampel baru);
# state membawa kohortnya sendiri sehingga ledger tidak pernah tercampur diam-diam.
RH_COHORT=mark30s-2026-10-07
# Rug-signal enrichment GMGN untuk kandidat RH (OBSERVASI dulu, bukan gerbang entry):
# N kandidat teratas per siklus yang lolos ≥1 filter diperkaya info+security GMGN (2 call/kandidat).
# 0 = matikan. Filter kohort-2 dibuat hanya setelah korelasi sinyal→rug terbukti di review harian.
RH_GMGN_ENRICH_MAX=2
# LIFE-2 (keputusan owner 2026-10-07): varian yang bankrut (equity < $4 → tak mampu posisi minimum)
# otomatis restart dengan modal $100 BARU berlabel `life`, setelah semua posisi life lama ditutup.
# P&L dilaporkan per-life DAN kumulatif; kematian tetap tercatat (event RH_BANKRUPT + RH_LIFE).
# false = varian mati permanen (biarkan mati).
RH_AUTO_LIFE=true
# Review harian jam lokal mesin + batas pool backtest.
RH_REVIEW_AT=08:00
RH_BT_POOLS=24
RH_BT_MIN_LIQ=20000

# OKX OnchainOS / Web3 — market, trenches, signal/radar, portfolio and DEX aggregation.
# ⚠️ JARINGAN INDONESIA (temuan 2026-10-08): okx.com di-hijack DNS oleh filter ISP
# (Internet Positif/Sehat) — DNS sistem menjawab IP halaman blokir, sehingga SEMUA endpoint OKX
# gagal "fetch failed". Jalur IP aslinya TERBUKA. Diagnosa + remediasi: `npm run okx:netcheck`.
# Jangan pernah mematikan verifikasi TLS untuk menembusnya.
# Create a project and API key in the OKX developer portal. No OKX call is made unless
# the read switch is true. Transaction building is supported but execution has a separate lock.
OKX_SHADOW_ENABLED=false
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_API_PASSPHRASE=
# OKX_PROJECT_ID is NOT part of the enable check, but the DEX API generally requires the
# OK-ACCESS-PROJECT header — leaving it blank is the most likely cause of "credentials look
# complete but every call 401s". `npm run okx:selftest` warns when it is empty.
OKX_PROJECT_ID=
# CEILING applied on top of each endpoint's own published limit, not the limit itself. OKX allows
# 5 rps on market/index/balance endpoints and 3 on aggregator ones; the adapter keeps a separate
# bucket per endpoint. This was 1 and was throttling every sweep to a fifth of its allowance.
OKX_MAX_RPS=5
OKX_TIMEOUT_MS=8000
# To use OKX as S2's real Solana route, BOTH values must be explicit. The global console LIVE
# switch and guardian caps remain mandatory; the bot signs locally and broadcasts through its
# own rotating RPC pool. Leave false for read-only/shadow use.
S2_EXEC_ROUTE=jupiter         # jupiter | okx | gmgn
OKX_EXECUTION_ENABLED=false
OKX_SLIPPAGE_PERCENT=3

# ── OKX WebSocket (wss://wsdex.okx.com/ws/v6/dex) ────────────────────────────────────────────
# Separate switch from the REST lane: REST is bucketed at ~1 rps and can never sit inside the
# 2.5s entry gate, whereas a stream costs nothing per event once connected.
# Channels: kol_smartmoney-tracker-activity, address-tracker-activity,
#           dex-market-new-signal-openapi, dex-market-memepump-new-token-openapi,
#           dex-market-memepump-update-metrics-openapi, price, price-info, trades,
#           dex-token-candle1m
# MEASURED 2026-08-29: ALL NINE channels return 60029 "not in whitelist" on a standard OnchainOS
# key — price and trades included, not just the tracker feeds. Streams need an account entitlement
# from OKX; until that is granted this must stay false. The lane detects it and closes cleanly.
OKX_WS_ENABLED=false
OKX_WS_CHANNELS=dex-market-memepump-new-token-openapi,dex-market-new-signal-openapi
# Up to 200 wallets for address-tracker-activity (OKX's cap), comma-separated.
OKX_TRACKED_WALLETS=
# Shadow copy-trading: records what following a tracked wallet WOULD have returned. Never buys.
OKX_COPY_SHADOW=false
# REST signal/copy fallback for accounts without WebSocket entitlement. The copy limit controls
# quota cost; raise to 200 only if the account quota can sustain polling that many wallets.
OKX_REST_SIGNAL_ENABLED=true
# 30s ≈86,400 calls/month continuously. Lower only when your OKX plan/quota supports it.
OKX_REST_SIGNAL_POLL_MS=30000
OKX_REST_COPY_POLL_MS=60000
OKX_REST_COPY_MAX_WALLETS=25
# Local radar/signal/copy → candidate ledger. Candidates are observation-only and cannot sign or
# broadcast. Max lag rejects signals we could not realistically follow in time.
OKX_CANDIDATE_QUEUE_ENABLED=true
OKX_CANDIDATE_MAX_LAG_MS=60000
OKX_CANDIDATE_MIN_AMOUNT_USD=0
OKX_CANDIDATE_MAX_RECORDS=1000
# Fixed horizons (seconds) every OKX signal is scored at. Same discipline as the exit observatory:
# a signal is judged on a clock we fix in advance, not on whichever window flatters it.
OKX_HORIZONS_SEC=60,300,900,2700
# Probe targets for `npm run okx:selftest -- --live` (read-only; nothing is traded).
OKX_PROBE_MINT=
OKX_PROBE_WALLET=

# ── OKX STRICT PAPER V2 ──────────────────────────────────────────────────────
# Unsigned mainnet transaction build + simulation only. This process never loads a private key,
# signs, or broadcasts. A funded PUBLIC address is needed solely because Solana simulation checks
# fee-payer balance; OKX_PROBE_WALLET is used as fallback when this is blank.
OKX_PAPER_WALLET=
# Measured minimum practical paper notional: 0.03 SOL paid 20-28% fixed entry overhead.
OKX_PAPER_SIZE_SOL=0.10
OKX_PAPER_SCAN_MS=10000
# Free/basic fallback: volume ranking stays usable when paid Trenches/Signal return HTTP 402.
# v6 REST burst: 0.2 RPS versus the published 5 RPS endpoint ceiling. The local 25k-call budget
# stops discovery automatically before a monthly quota can run away.
OKX_PAPER_RANKING_MS=5000
OKX_PAPER_RANKING_RECHECK_MS=5000
OKX_PAPER_RANKING_MAX_ACCEPT_PER_PASS=3
# Prospective v4 scalp lane: only the first five minutes and micro-cap range.
OKX_PAPER_RANKING_MAX_AGE_MS=300000
OKX_PAPER_RANKING_MAX_MARKET_CAP_USD=250000
OKX_PAPER_RANKING_MIN_LIQUIDITY_USD=20000
OKX_PAPER_RANKING_MIN_VOLUME_USD=20000
OKX_PAPER_RANKING_MIN_HOLDERS=100
OKX_PAPER_RANKING_MIN_TRANSACTIONS=100
OKX_PAPER_RANKING_MIN_BUY_RATIO=0.6
OKX_PAPER_RANKING_WARM_START_MAX=8
OKX_PAPER_SIGNAL_MS=30000
OKX_PAPER_TRACKER_MS=60000
OKX_PAPER_TRACKER_WALLETS=5
OKX_PAPER_HORIZONS_SEC=60,300,900,2700
# v6's precommitted maximum hold; longer fixed horizons remain diagnostic only.
OKX_PAPER_PRIMARY_EXIT_HORIZON_SEC=60
OKX_PAPER_MAX_OPEN=500
# Local hard caps preserve quota for manual/API use. Exits are never paused by these entry-source
# budgets because abandoning an open observation would bias the result toward survivors.
# Jaring LOKAL jumlah panggilan lane kertas (bukan kuota upstream OKX). Naikkan bila eksperimen
# butuh lebih banyak trade; pause tetap ada sebagai pengaman.
OKX_PAPER_PREMIUM_BUDGET_CALLS=10000
OKX_PAPER_BASIC_BUDGET_CALLS=25000
OKX_PAPER_SIGNAL_MIN_WALLETS=2
OKX_PAPER_SIGNAL_MIN_USD=500
OKX_PAPER_TRACKER_MIN_USD=100
OKX_PAPER_MAX_SOURCE_LAG_MS=90000
OKX_PAPER_MAX_PRICE_IMPACT_PERCENT=5
OKX_PAPER_MAX_ENTRY_OVERHEAD_PCT=7
# Entry is recorded only if two time-separated unsigned reverse routes exist, both conservative
# round-trip floors pass, the second route has not deteriorated, and the full check is still fresh.
OKX_PAPER_MIN_PREFLIGHT_ROUNDTRIP_PNL_PCT=-12
OKX_PAPER_SELL_CONFIRM_MS=1500
OKX_PAPER_MAX_SELL_PROOF_DROP_PCT=3
OKX_PAPER_MAX_DETECT_TO_BUILD_MS=15000
OKX_PAPER_WORKERS=3
# Fail closed by default: scanner cache or Micincloud's on-chain setup gate must say CLEAN.
OKX_PAPER_ALLOW_UNKNOWN_RISK=false
# Ranking lacks paid actor fields. UNKNOWN observations may open only as clearly labelled
# PAPER-ONLY positions; they are never counted as live-eligible.
OKX_PAPER_OBSERVE_UNKNOWN_RANKING=true
OKX_PAPER_EXIT_FEE_FLOOR_LAMPORTS=20000
OKX_PAPER_MAX_ENTRY_OVERHEAD_LAMPORTS=10000000
# Prospective v6 scalp policy. A TP/stop/timeout quote is only a trigger; PnL comes from a fresh
# post-delay sell build. Three consecutive missing routes settle as a full loss.
OKX_PAPER_SCALP_POLL_MS=5000
OKX_PAPER_SCALP_TAKE_PROFIT_PCT=5
OKX_PAPER_SCALP_HARD_STOP_PCT=-8
OKX_PAPER_SCALP_MAX_HOLD_SEC=60
OKX_PAPER_EXECUTION_DELAY_MS=1500
OKX_PAPER_SCALP_MAX_NO_ROUTE=3
OKX_PAPER_SCALP_NO_ROUTE_RETRY_MS=1000
# HTTP 402 means the current Market tier/quota cannot serve that source. Retry slowly so the bot
# resumes after quota reset/upgrade without wasting calls or misreporting an empty market.
OKX_PAPER_PAYMENT_BACKOFF_MS=900000

# Mode: fast-follow | swing | both   (default: both)
MODE=both

# Sniper tuning
SNIPE_SETTLE_MS=8000       # ms after launch before gating (lower=earlier/smaller MC)
SNIPE_MAX_MC_SOL=80        # hard entry-MC ceiling in SOL (lower=stricter)
MIN_SCORE_TO_OPEN=62       # min gate score (0-100) to actually buy (higher=stricter)

# Compounding (position size grows with balance, capped by curve liquidity)
COMPOUND=false             # true = size scales with paper balance
STARTING_FLOAT_SOL=0.5     # starting paper capital
RISK_PER_TRADE_PCT=20      # % of balance per trade when compounding
MAX_CURVE_FRAC_PCT=3       # hard cap: never exceed this % of the bonding curve's SOL (slippage ceiling)

# Paper-trade sizing (SOL) — simulation only
PAPER_TRADE_SIZE_SOL=0.1

# Web console login password (set your own) and port
DASHBOARD_PASSWORD=solscout
DASHBOARD_PORT=4317

# Postgres / Supabase (optional). Set to enable DB dual-write. Same URL works for
# local Postgres or Supabase — migrating to Supabase = just swap this string.
#   local:    postgresql://user:pass@localhost:5432/solscout
#   supabase: postgresql://postgres:[pass]@db.[ref].supabase.co:5432/postgres
# Then run: npm run db:init
DATABASE_URL=

# ── 24/7 OPERATION (see deploy/README.md) ──────────────────────────────────
# Dashboard bind. Default 127.0.0.1 (loopback only) — reach it via Cloudflare Tunnel or
# `ssh -L 4317:127.0.0.1:4317 user@vps`. The server REFUSES to start on a public interface
# while DASHBOARD_PASSWORD is still the default, because the console can withdraw SOL.
# DASHBOARD_HOST=0.0.0.0

# Telegram operational alerts — startup / crash / watchdog restart / ledger drift ONLY.
# Deliberately not per-trade: a channel that pings constantly gets muted, and then it is
# worthless when something real breaks. Unset = disabled.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=987654321

# Watchdog: restart if the launch feed delivers nothing for this long. Guards the silent
# failure where the WebSocket is half-closed so the bot is "up" but blind.
# WATCHDOG_STALL_MS=300000

# DexScreener realtime (2026-10-08): 6 stream WebSocket DIUKUR terbuka tanpa kunci/akun (HTTP 101 +
# data mengalir dalam detik). Set false hanya bila ingin polling REST murni.
DEX_FULL_WS=true

# PENJAGA RISIKO (aktif 2026-10-12) — batas DIAMBIL DARI PENGUKURAN, bukan karangan.
# Ukuran: rugi per-trade terburuk anchor $12,51 · eksposur terbuka terukur $890/62 posisi ·
# plafon 8 posisi/varian × 21 arm aktif. Aturan: rugi harian = ½×(klaster 20 posisi × $12,51);
# notional = max(1,6× eksposur terukur, plafon teoritis); posisi = plafon teoritis.
# Catatan jujur: anchor BELUM pernah punya hari rugi (terburuk +$33), jadi batas rugi harian adalah
# IKATAN MODEL dari risiko per-trade — bukan hari rugi yang pernah terukur. Sengaja longgar supaya
# tidak menghalangi hari normal, tapi menghentikan hari klaster.
RISK_MAX_DAILY_LOSS_USD=125
RISK_MAX_TOTAL_NOTIONAL_USD=2000
RISK_MAX_OPEN_POSITIONS=168
