# ── MemeCloud dry-run MVP ─────────────────────────────────────────────
# Everything works without keys (public RPC + keyless APIs) but free keys
# raise rate limits a lot. Register per RESEARCH.md §7. NEVER put a wallet
# private key in this file — the MVP has no wallet and must stay that way.

# Helius free key → https://helius.dev (primary RPC). Leave empty to use public RPC.
HELIUS_API_KEY=

# Fallback/custom RPC URL (optional; overrides the public default)
RPC_URL=

# Backup RPC URL (optional) — e.g. FluxRPC from the rugcheck.xyz dashboard
RPC_BACKUP_URL=

# RugCheck report API works keyless (~10 req/min). NOTE: the key shown in the
# rugcheck.xyz dashboard is a FluxRPC key (use it as RPC_BACKUP_URL above), NOT
# a report-API key — api.rugcheck.xyz returns 401 if you send it as X-API-KEY.
RUGCHECK_API_KEY=

# Jupiter free API key (portal.jup.ag) — real swap slippage + sell-sim for swing
# tokens, sent as x-api-key. Works keyless too (lower rate limit).
JUPITER_API_KEY=

# Mode: fast-follow | swing | both   (default: both)
MODE=both

# Sniper tuning
SNIPE_SETTLE_MS=8000       # ms after launch before gating (lower=earlier/smaller MC)
SNIPE_MAX_MC_SOL=80        # hard entry-MC ceiling in SOL (lower=stricter)
MIN_SCORE_TO_OPEN=62       # min gate score (0-100) to actually buy (higher=stricter)

# Compounding (position size grows with balance, capped by curve liquidity)
COMPOUND=false             # true = size scales with paper balance
STARTING_FLOAT_SOL=0.5     # starting paper capital
RISK_PER_TRADE_PCT=20      # % of balance per trade when compounding
MAX_CURVE_FRAC_PCT=3       # hard cap: never exceed this % of the bonding curve's SOL (slippage ceiling)

# Paper-trade sizing (SOL) — simulation only
PAPER_TRADE_SIZE_SOL=0.1

# Web console login password (set your own) and port
DASHBOARD_PASSWORD=solscout
DASHBOARD_PORT=4317

# Postgres / Supabase (optional). Set to enable DB dual-write. Same URL works for
# local Postgres or Supabase — migrating to Supabase = just swap this string.
#   local:    postgresql://user:pass@localhost:5432/solscout
#   supabase: postgresql://postgres:[pass]@db.[ref].supabase.co:5432/postgres
# Then run: npm run db:init
DATABASE_URL=

# ── 24/7 OPERATION (see deploy/README.md) ──────────────────────────────────
# Dashboard bind. Default 127.0.0.1 (loopback only) — reach it via Cloudflare Tunnel or
# `ssh -L 4317:127.0.0.1:4317 user@vps`. The server REFUSES to start on a public interface
# while DASHBOARD_PASSWORD is still the default, because the console can withdraw SOL.
# DASHBOARD_HOST=0.0.0.0

# Telegram operational alerts — startup / crash / watchdog restart / ledger drift ONLY.
# Deliberately not per-trade: a channel that pings constantly gets muted, and then it is
# worthless when something real breaks. Unset = disabled.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=987654321

# Watchdog: restart if the launch feed delivers nothing for this long. Guards the silent
# failure where the WebSocket is half-closed so the bot is "up" but blind.
# WATCHDOG_STALL_MS=300000
